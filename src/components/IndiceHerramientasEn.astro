<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('idx-search-en') as HTMLInputElement;
    const catButtons = document.querySelectorAll('.idx-cat-btn-en');
    const idxCards = document.querySelectorAll('.idx-item-en');
    const idxLinks = document.querySelectorAll('.idx-link-en');

    let currentCat = 'all';
    let searchQuery = '';

    idxLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = link.getAttribute('href');
        if (!targetId) return;
        const targetElement = document.querySelector(targetId);
        if (targetElement) {
          const headerOffset = 90;
          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });

          targetElement.classList.add('highlight-target');
          setTimeout(() => {
            targetElement.classList.remove('highlight-target');
          }, 2000);
        }
      });
    });

    function filterCards() {
      idxCards.forEach(card => {
        const cat = card.getAttribute('data-cat') || '';
        const keywords = card.getAttribute('data-keywords') || '';
        const title = (card.querySelector('h4')?.textContent || '').toLowerCase();
        
        const matchesCat = currentCat === 'all' || cat === currentCat;
        const matchesSearch = searchQuery === '' || 
          title.includes(searchQuery) || 
          keywords.includes(searchQuery);

        if (matchesCat && matchesSearch) {
          (card as HTMLElement).style.display = 'block';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value.trim().toLowerCase();
        filterCards();
      });
    }

    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        catButtons.forEach(b => {
          b.classList.remove('active');
          (b as HTMLElement).style.background = 'rgba(255,255,255,0.03)';
          (b as HTMLElement).style.color = 'var(--text-secondary)';
          (b as HTMLElement).style.borderColor = 'var(--border-color)';
        });
        
        btn.classList.add('active');
        (btn as HTMLElement).style.background = 'var(--accent)';
        (btn as HTMLElement).style.color = 'var(--text-dark)';
        (btn as HTMLElement).style.borderColor = 'transparent';

        currentCat = btn.getAttribute('data-cat') || 'all';
        filterCards();
      });
    });
  });
</script>
