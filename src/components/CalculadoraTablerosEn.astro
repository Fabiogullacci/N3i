<!-- SCRIPTS & LOGIC -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Inputs
    const iRed = document.getElementById('tab-red-en') as HTMLSelectElement;
    const iMarca = document.getElementById('tab-marca-en') as HTMLSelectElement;
    const iSimultaneidad = document.getElementById('tab-simultaneidad-en') as HTMLInputElement;
    const iBocasTug = document.getElementById('tab-bocas-tug-en') as HTMLInputElement;
    const iBocasIug = document.getElementById('tab-bocas-iug-en') as HTMLInputElement;
    const iBocasTue = document.getElementById('tab-bocas-tue-en') as HTMLInputElement;
    const iBocasIue = document.getElementById('tab-bocas-iue-en') as HTMLInputElement;
    const iWIue = document.getElementById('tab-w-iue-en') as HTMLInputElement;
    const iMotoresMono = document.getElementById('tab-motores-mono-en') as HTMLInputElement;
    const iHpMono = document.getElementById('tab-hp-mono-en') as HTMLSelectElement;
    const iMotoresTri = document.getElementById('tab-motores-tri-en') as HTMLInputElement;
    const iHpTri = document.getElementById('tab-hp-tri-en') as HTMLSelectElement;
    const iAscensores = document.getElementById('tab-ascensores-en') as HTMLInputElement;
    const iAcCant = document.getElementById('tab-ac-cant-en') as HTMLInputElement;
    const iAcFrigorias = document.getElementById('tab-ac-frigorias-en') as HTMLSelectElement;

    // Tabs
    const tabBtns = document.querySelectorAll('.tab-btn-en');
    const tabContents = document.querySelectorAll('.tab-content-en');
    const btnTabBalanceo = document.getElementById('btn-tab-balanceo-en');

    // Tab buttons event
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const tabId = btn.getAttribute('data-tab');
        
        tabBtns.forEach(b => {
          b.classList.remove('active');
          (b as HTMLElement).style.background = 'transparent';
          (b as HTMLElement).style.color = 'var(--text-secondary)';
          (b as HTMLElement).style.borderColor = 'var(--border-color)';
        });
        
        btn.classList.add('active');
        (btn as HTMLElement).style.background = 'rgba(255, 145, 0, 0.1)';
        (btn as HTMLElement).style.color = '#FF9100';
        (btn as HTMLElement).style.borderColor = '#FF9100';

        tabContents.forEach(content => {
          if (content.id === tabId) {
            (content as HTMLElement).style.display = 'block';
          } else {
            (content as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // Toggle trifasico inputs depending on grid selection
    function handleRedChange() {
      const red = iRed.value;
      if (red === 'monofasica') {
        if (iMotoresTri) iMotoresTri.disabled = true;
        if (iHpTri) iHpTri.disabled = true;
        if (iAscensores) iAscensores.disabled = true;
        if (btnTabBalanceo) btnTabBalanceo.style.display = 'none';
        
        if (iMotoresTri) iMotoresTri.value = '0';
        if (iAscensores) iAscensores.value = '0';
      } else {
        if (iMotoresTri) iMotoresTri.disabled = false;
        if (iHpTri) iHpTri.disabled = false;
        if (iAscensores) iAscensores.disabled = false;
        if (btnTabBalanceo) btnTabBalanceo.style.display = 'block';
      }
      calculateTablero();
    }

    iRed.addEventListener('change', handleRedChange);

    // Main calculation
    function calculateTablero() {
      const isTrifasica = iRed.value === 'trifasica';
      const marca = iMarca.value;
      const fs = parseFloat(iSimultaneidad.value) || 0.8;
      
      const bocasTug = parseInt(iBocasTug.value) || 0;
      const bocasIug = parseInt(iBocasIug.value) || 0;
      const bocasTue = parseInt(iBocasTue.value) || 0;
      const bocasIue = parseInt(iBocasIue.value) || 0;
      const wIue = parseFloat(iWIue.value) || 150;
      
      const motoresMono = parseInt(iMotoresMono.value) || 0;
      const hpMono = parseFloat(iHpMono.value) || 1.0;
      const motoresTri = isTrifasica ? (parseInt(iMotoresTri.value) || 0) : 0;
      const hpTri = parseFloat(iHpTri.value) || 2.0;
      const ascensores = isTrifasica ? (parseInt(iAscensores.value) || 0) : 0;
      
      const acCant = parseInt(iAcCant.value) || 0;
      const acFrigorias = parseInt(iAcFrigorias.value) || 9000;

      let circuitos: any[] = [];
      let nextCircNum = 1;

      // 1. IUG
      if (bocasIug > 0) {
        const nCircIug = Math.ceil(bocasIug / 15);
        const bocasPerCirc = Math.ceil(bocasIug / nCircIug);
        for (let i = 0; i < nCircIug; i++) {
          circuitos.push({
            id: nextCircNum++,
            tipo: 'GP-LIGHT',
            desc: `GP Lighting (Circuit ${i+1})`,
            bocas: bocasPerCirc,
            potenciaVA: 1500,
            currentIb: 1500 / 220,
            cableSec: 1.5,
            breakerIn: 10,
            poles: 2,
            curva: 'C',
            fase: 'R'
          });
        }
      }

      // 2. TUG
      if (bocasTug > 0) {
        const nCircTug = Math.ceil(bocasTug / 15);
        const bocasPerCirc = Math.ceil(bocasTug / nCircTug);
        for (let i = 0; i < nCircTug; i++) {
          circuitos.push({
            id: nextCircNum++,
            tipo: 'GP-SOCK',
            desc: `GP Sockets (Circuit ${i+1})`,
            bocas: bocasPerCirc,
            potenciaVA: 2200,
            currentIb: 2200 / 220,
            cableSec: 2.5,
            breakerIn: 16,
            poles: 2,
            curva: 'C',
            fase: 'R'
          });
        }
      }

      // 3. IUE
      if (bocasIue > 0) {
        const nCircIue = Math.ceil(bocasIue / 12);
        const bocasPerCirc = Math.ceil(bocasIue / nCircIue);
        const totalW = bocasIue * wIue;
        const wPerCirc = totalW / nCircIue;
        for (let i = 0; i < nCircIue; i++) {
          circuitos.push({
            id: nextCircNum++,
            tipo: 'SP-LIGHT',
            desc: `SP Floodlights (${bocasPerCirc} x ${wIue}W)`,
            bocas: bocasPerCirc,
            potenciaVA: wPerCirc / 0.9,
            currentIb: (wPerCirc / 0.9) / 220,
            cableSec: 2.5,
            breakerIn: 16,
            poles: 2,
            curva: 'C',
            fase: 'R'
          });
        }
      }

      // 4. TUE
      if (bocasTue > 0) {
        const nCircTue = Math.ceil(bocasTue / 12);
        const bocasPerCirc = Math.ceil(bocasTue / nCircTue);
        for (let i = 0; i < nCircTue; i++) {
          circuitos.push({
            id: nextCircNum++,
            tipo: 'SP-SOCK',
            desc: `SP Sockets (20A Sockets) (Circuit ${i+1})`,
            bocas: bocasPerCirc,
            potenciaVA: 3300,
            currentIb: 3300 / 220,
            cableSec: 4.0,
            breakerIn: 20,
            poles: 2,
            curva: 'C',
            fase: 'R'
          });
        }
      }

      // 5. MOTORES MONO
      if (motoresMono > 0) {
        const wActiva = hpMono * 746;
        const currentNom = wActiva / (220 * 0.8 * 0.8);
        for (let i = 0; i < motoresMono; i++) {
          circuitos.push({
            id: nextCircNum++,
            tipo: 'MTR-MONO',
            desc: `Single-phase Motor ${hpMono} HP`,
            bocas: 1,
            potenciaVA: wActiva / 0.8,
            currentIb: currentNom,
            cableSec: 2.5,
            breakerIn: currentNom > 12 ? 20 : 16,
            poles: 2,
            curva: 'D',
            fase: 'R'
          });
        }
      }

      // 6. MOTORES TRI
      if (motoresTri > 0 && isTrifasica) {
        const wActiva = hpTri * 746;
        const currentNom = wActiva / (Math.sqrt(3) * 380 * 0.85 * 0.8);
        for (let i = 0; i < motoresTri; i++) {
          circuitos.push({
            id: nextCircNum++,
            tipo: 'MTR-TRI',
            desc: `Three-phase Motor ${hpTri} HP`,
            bocas: 1,
            potenciaVA: wActiva / 0.85,
            currentIb: currentNom,
            cableSec: 2.5,
            breakerIn: currentNom > 12 ? 20 : (currentNom > 8 ? 16 : 10),
            poles: 4,
            curva: 'D',
            fase: 'RST'
          });
        }
      }

      // 7. ASCENSORES
      if (ascensores > 0 && isTrifasica) {
        const wActiva = 7.5 * 746;
        const currentNom = wActiva / (Math.sqrt(3) * 380 * 0.85 * 0.8);
        for (let i = 0; i < ascensores; i++) {
          circuitos.push({
            id: nextCircNum++,
            tipo: 'LIFT',
            desc: `Three-phase Lift/Elevator 7.5 HP`,
            bocas: 1,
            potenciaVA: wActiva / 0.85,
            currentIb: currentNom,
            cableSec: 4.0,
            breakerIn: 20,
            poles: 4,
            curva: 'D',
            fase: 'RST'
          });
        }
      }

      // 8. AC
      if (acCant > 0) {
        const capTermicaW = acFrigorias * 1.163;
        const potElectricaW = capTermicaW / 3.2;
        const potElectricaVA = potElectricaW / 0.9;
        const acIsTrifasico = isTrifasica && acFrigorias >= 9000;

        let currentNom = 0;
        if (acIsTrifasico) {
          currentNom = potElectricaW / (Math.sqrt(3) * 380 * 0.9);
        } else {
          currentNom = potElectricaW / (220 * 0.9);
        }

        for (let i = 0; i < acCant; i++) {
          let cable = 2.5;
          let breaker = 16;
          if (!acIsTrifasico && currentNom > 13) {
            cable = 4.0;
            breaker = 20;
          }

          circuitos.push({
            id: nextCircNum++,
            tipo: 'AC',
            desc: `AC Unit ${acFrigorias} Frigorías (${acIsTrifasico ? 'Three-phase' : 'Single-phase'})`,
            bocas: 1,
            potenciaVA: potElectricaVA,
            currentIb: currentNom,
            cableSec: cable,
            breakerIn: breaker,
            poles: acIsTrifasico ? 4 : 2,
            curva: 'C',
            fase: acIsTrifasico ? 'RST' : 'R'
          });
        }
      }

      // BALANCEO DE FASES GREEDY (Trifasica)
      let powerR = 0, currentR = 0;
      let powerS = 0, currentS = 0;
      let powerT = 0, currentT = 0;

      circuitos.forEach(c => {
        if (c.fase === 'RST') {
          powerR += c.potenciaVA / 3;
          currentR += c.currentIb;
          powerS += c.potenciaVA / 3;
          currentS += c.currentIb;
          powerT += c.potenciaVA / 3;
          currentT += c.currentIb;
        }
      });

      if (isTrifasica) {
        const monofasicos = circuitos.filter(c => c.fase !== 'RST');
        monofasicos.sort((a, b) => b.currentIb - a.currentIb);

        monofasicos.forEach(c => {
          if (currentR <= currentS && currentR <= currentT) {
            c.fase = 'R';
            powerR += c.potenciaVA;
            currentR += c.currentIb;
          } else if (currentS <= currentR && currentS <= currentT) {
            c.fase = 'S';
            powerS += c.potenciaVA;
            currentS += c.currentIb;
          } else {
            c.fase = 'T';
            powerT += c.potenciaVA;
            currentT += c.currentIb;
          }
        });
      } else {
        circuitos.forEach(c => {
          c.fase = 'R';
          powerR += c.potenciaVA;
          currentR += c.currentIb;
        });
        powerS = currentS = powerT = currentT = 0;
      }

      let dmpsVA = 0;
      let maxFaseCurrent = 0;
      
      if (isTrifasica) {
        const totalVA = powerR + powerS + powerT;
        dmpsVA = totalVA * fs;
        maxFaseCurrent = Math.max(currentR, currentS, currentT) * fs;
      } else {
        dmpsVA = powerR * fs;
        maxFaseCurrent = currentR * fs;
      }

      let igaIn = 16;
      const standardBreakers = [16, 20, 25, 32, 40, 50, 63, 80, 100];
      for (let i = 0; i < standardBreakers.length; i++) {
        if (standardBreakers[i] >= maxFaseCurrent) {
          igaIn = standardBreakers[i];
          break;
        }
        if (i === standardBreakers.length - 1) {
          igaIn = 100;
        }
      }

      // RENDER CIRCUIT SCHEDULE
      const tbody = document.getElementById('tab-planilla-tbody-en');
      const printTbody = document.getElementById('print-planilla-tbody-en');
      let tbodyHtml = '';

      circuitos.forEach(c => {
        tbodyHtml += `
          <tr style="border-bottom: 1px solid var(--border-color);">
            <td style="padding: 10px; font-weight: bold;">C${c.id}</td>
            <td style="padding: 10px;">${c.desc}</td>
            <td style="padding: 10px; text-align: center;">${c.bocas} pts</td>
            <td style="padding: 10px; text-align: center;">${Math.round(c.potenciaVA)} VA</td>
            <td style="padding: 10px; text-align: center;">${c.currentIb.toFixed(1)} A</td>
            <td style="padding: 10px; text-align: center;">${c.cableSec.toFixed(1)} mm²</td>
            <td style="padding: 10px; text-align: center; font-weight: 600;">${c.breakerIn}A (Curve ${c.curva})</td>
            <td style="padding: 10px; text-align: center; font-weight: bold; color: ${c.fase === 'R' ? '#ff4444' : (c.fase === 'S' ? '#ffcc00' : (c.fase === 'T' ? '#33b5e5' : '#8CC63F'))};">${c.fase}</td>
          </tr>
        `;
      });

      if (tbody) tbody.innerHTML = tbodyHtml;
      if (printTbody) printTbody.innerHTML = tbodyHtml;

      // DIN RAIL LAYOUT
      const rielCont = document.getElementById('riel-din-contenedor-en');
      const printRielCont = document.getElementById('print-riel-din-contenedor-en');
      let rielHtml = '';

      const igaPoles = isTrifasica ? 4 : 2;
      rielHtml += createDINModule(`MCB (${igaPoles}P)`, `${igaIn}A`, 'iga', igaPoles, marca);
      const dpsRating = isTrifasica ? '3L+N' : 'L+N';
      rielHtml += createDINModule(`SPD Class II`, dpsRating, 'dps', igaPoles, marca);

      let modulosOcupados = igaPoles + igaPoles;

      if (!isTrifasica) {
        const totalCircs = circuitos.length;
        const nDisy = Math.ceil(totalCircs / 4);
        
        for (let d = 0; d < nDisy; d++) {
          const rcdIn = igaIn >= 40 ? 40 : 25;
          rielHtml += createDINModule(`RCD ${d+1}`, `${rcdIn}A 30mA`, 'rcd', 2, marca);
          modulosOcupados += 2;

          const circsGrupo = circuitos.slice(d*4, (d+1)*4);
          circsGrupo.forEach(c => {
            rielHtml += createDINModule(`C${c.id}`, `${c.breakerIn}A`, 'breaker', 2, marca, c.tipo);
            modulosOcupados += 2;
          });
        }
      } else {
        const trifasicos = circuitos.filter(c => c.fase === 'RST');
        const monofasicos = circuitos.filter(c => c.fase !== 'RST');

        if (trifasicos.length > 0) {
          rielHtml += createDINModule(`RCD Tri.`, `40A 30mA`, 'rcd', 4, marca);
          modulosOcupados += 4;
          trifasicos.forEach(c => {
            rielHtml += createDINModule(`C${c.id} RST`, `${c.breakerIn}A`, 'breaker', 4, marca, c.tipo);
            modulosOcupados += 4;
          });
        }

        const circsR = monofasicos.filter(c => c.fase === 'R');
        const circsS = monofasicos.filter(c => c.fase === 'S');
        const circsT = monofasicos.filter(c => c.fase === 'T');

        if (circsR.length > 0) {
          rielHtml += createDINModule(`RCD Ph. R`, `25A 30mA`, 'rcd', 2, marca);
          modulosOcupados += 2;
          circsR.forEach(c => {
            rielHtml += createDINModule(`C${c.id} R`, `${c.breakerIn}A`, 'breaker', 2, marca, c.tipo);
            modulosOcupados += 2;
          });
        }
        if (circsS.length > 0) {
          rielHtml += createDINModule(`RCD Ph. S`, `25A 30mA`, 'rcd', 2, marca);
          modulosOcupados += 2;
          circsS.forEach(c => {
            rielHtml += createDINModule(`C${c.id} S`, `${c.breakerIn}A`, 'breaker', 2, marca, c.tipo);
            modulosOcupados += 2;
          });
        }
        if (circsT.length > 0) {
          rielHtml += createDINModule(`RCD Ph. T`, `25A 30mA`, 'rcd', 2, marca);
          modulosOcupados += 2;
          circsT.forEach(c => {
            rielHtml += createDINModule(`C${c.id} T`, `${c.breakerIn}A`, 'breaker', 2, marca, c.tipo);
            modulosOcupados += 2;
          });
        }
      }

      if (rielCont) rielCont.innerHTML = rielHtml;
      if (printRielCont) printRielCont.innerHTML = rielHtml;

      const rModulos = document.getElementById('tab-res-modulos-en');
      const rGabinete = document.getElementById('tab-res-gabinete-en');
      const rReserva = document.getElementById('tab-res-reserva-en');
      const rDmps = document.getElementById('tab-res-dmps-en');
      const rAmperes = document.getElementById('tab-res-amperes-en');

      if (rModulos) rModulos.textContent = modulosOcupados.toString();

      const gabinetesComerciales = [12, 18, 24, 36, 48, 54, 72];
      let suggestedGab = 72;
      let reservaPerc = 0;
      
      for (let g = 0; g < gabinetesComerciales.length; g++) {
        if (gabinetesComerciales[g] >= modulosOcupados * 1.2) {
          suggestedGab = gabinetesComerciales[g];
          reservaPerc = Math.round(((suggestedGab - modulosOcupados) / suggestedGab) * 100);
          break;
        }
      }

      if (rGabinete) rGabinete.textContent = `${suggestedGab} Ways`;
      if (rReserva) rReserva.textContent = `Enclosure reserve: ${reservaPerc}% (${suggestedGab - modulosOcupados} slots free).`;

      const activePowerKw = (dmpsVA * 0.9) / 1000;
      if (rDmps) rDmps.textContent = `${activePowerKw.toFixed(1)} kW`;
      if (rAmperes) rAmperes.textContent = `${maxFaseCurrent.toFixed(1)} A max / phase`;

      // UPDATE BALANCE GRAPH
      const balWR = document.getElementById('balance-w-r-en');
      const balAS = document.getElementById('balance-a-r-en');
      const balWS = document.getElementById('balance-w-s-en');
      const balASS = document.getElementById('balance-a-s-en');
      const balWT = document.getElementById('balance-w-t-en');
      const balAST = document.getElementById('balance-a-t-en');

      const barR = document.getElementById('balance-bar-r-en');
      const barS = document.getElementById('balance-bar-s-en');
      const barT = document.getElementById('balance-bar-t-en');

      if (isTrifasica) {
        if (balWR) balWR.textContent = `${Math.round(powerR * 0.9)} W`;
        if (balAS) balAS.textContent = `${currentR.toFixed(1)} A`;
        if (balWS) balWS.textContent = `${Math.round(powerS * 0.9)} W`;
        if (balASS) balASS.textContent = `${currentS.toFixed(1)} A`;
        if (balWT) balWT.textContent = `${Math.round(powerT * 0.9)} W`;
        if (balAST) balAST.textContent = `${currentT.toFixed(1)} A`;

        const maxCurrentVal = Math.max(currentR, currentS, currentT, 1);
        if (barR) barR.style.width = `${(currentR / maxCurrentVal) * 100}%`;
        if (barS) barS.style.width = `${(currentS / maxCurrentVal) * 100}%`;
        if (barT) barT.style.width = `${(currentT / maxCurrentVal) * 100}%`;

        const promCurrent = (currentR + currentS + currentT) / 3;
        const maxDiff = Math.max(Math.abs(currentR - promCurrent), Math.abs(currentS - promCurrent), Math.abs(currentT - promCurrent));
        const desbalanceo = promCurrent > 0 ? (maxDiff / promCurrent) * 100 : 0;

        const diagAlert = document.getElementById('balanceo-diagnostic-alert-en');
        if (diagAlert) {
          if (desbalanceo <= 10) {
            diagAlert.style.borderLeft = '4px solid #8CC63F';
            diagAlert.style.background = 'rgba(140, 198, 99, 0.08)';
            diagAlert.innerHTML = `✅ <strong>Optimal Balance:</strong> Phase imbalance is only <strong>${desbalanceo.toFixed(1)}%</strong> (Standard < 15%). The load distribution is excellent, minimizing neutral conductor stress.`;
          } else if (desbalanceo <= 16) {
            diagAlert.style.borderLeft = '4px solid #ff9800';
            diagAlert.style.background = 'rgba(255, 152, 0, 0.08)';
            diagAlert.innerHTML = `⚠️ <strong>Acceptable Balance:</strong> Phase imbalance is <strong>${desbalanceo.toFixed(1)}%</strong>. Meets requirements, but assign future new loads to the lowest-consuming phase.`;
          } else {
            diagAlert.style.borderLeft = '4px solid #c65353';
            diagAlert.style.background = 'rgba(198, 83, 83, 0.08)';
            diagAlert.innerHTML = `🚨 <strong>Severe Imbalance:</strong> Phase imbalance is <strong>${desbalanceo.toFixed(1)}%</strong>. This exceeds 15% recommendations and might overheat neutral wiring. Consider re-allocating heavy single-phase circuits.`;
          }
        }
      }

      // TERMINAL BLOCKS
      const rBorneras = document.getElementById('tab-res-borneras-en');
      let bornerasTexto = '';
      let bornerasNombre = 'None required';

      if (circuitos.length > 5) {
        if (isTrifasica) {
          bornerasNombre = `4-Pole (Tetrapolar) Distribution Terminal Block of ${igaIn >= 63 ? 125 : 100}A`;
          bornerasTexto = `With **${circuitos.length} circuits** on three-phase system, it is **essential** to install a **4-Pole Distribution Block DIN (4P) of ${igaIn >= 63 ? '125A' : '100A'}** with at least 7 termination ports. This guarantees a safe transition from the main incomer to secondary RCDs.`;
        } else {
          bornerasNombre = `2-Pole (Bipolar) Distribution Terminal Block of ${igaIn >= 40 ? 100 : 80}A`;
          bornerasTexto = `For organizing internal wiring in this single-phase panel of **${circuitos.length} circuits**, installing a **2-Pole Distribution Block DIN (2P) of ${igaIn >= 40 ? '100A' : '80A'}** with 6 to 8 connection ports is recommended.`;
        }
      } else {
        bornerasTexto = `With few circuits (**${circuitos.length}**), distributing the connections using standard insulated busbar comb bridges is safe and efficient.`;
      }

      if (rBorneras) rBorneras.innerHTML = bornerasTexto;

      // UPDATE PRINT AREA VARIABLES
      const pSuministro = document.getElementById('print-suministro-en');
      const pMarca = document.getElementById('print-marca-en');
      const pFs = document.getElementById('print-fs-en');
      const pDmps = document.getElementById('print-dmps-en');
      const pIga = document.getElementById('print-iga-en');
      const pBorneras = document.getElementById('print-borneras-en');
      const pModulos = document.getElementById('print-modulos-en');
      const pGabinete = document.getElementById('print-gabinete-en');

      if (pSuministro) pSuministro.textContent = isTrifasica ? 'Three-phase (380V / 220V)' : 'Single-phase (220V)';
      if (pMarca) pMarca.textContent = marca === 'schneider' ? 'Schneider Electric (Acti9 / Easy9)' : 'Siemens (Sentron 5SY / 5SL)';
      if (pFs) pFs.textContent = fs.toString();
      if (pDmps) pDmps.textContent = `${activePowerKw.toFixed(1)} kW (${Math.round(dmpsVA)} VA)`;
      if (pIga) pIga.textContent = `${igaPoles}P x ${igaIn}A (Curve C, Breaking capacity: ${marca==='schneider'?'4.5kA / 6kA':'6kA'})`;
      if (pBorneras) pBorneras.textContent = bornerasNombre;
      if (pModulos) pModulos.textContent = `${modulosOcupados} DIN modules`;
      if (pGabinete) pGabinete.textContent = `${suggestedGab} DIN Modules (+${reservaPerc}% reserve)`;

      const printSecBalanceo = document.getElementById('print-section-balanceo-en');
      if (printSecBalanceo) {
        if (isTrifasica) {
          printSecBalanceo.style.display = 'block';
          const pBR = document.getElementById('print-balance-r-en');
          const pBAR = document.getElementById('print-balance-a-r-en');
          const pBS = document.getElementById('print-balance-s-en');
          const pBAS = document.getElementById('print-balance-a-s-en');
          const pBT = document.getElementById('print-balance-t-en');
          const pBAT = document.getElementById('print-balance-a-t-en');
          const pBText = document.getElementById('print-balance-text-en');

          if (pBR) pBR.textContent = `${Math.round(powerR * 0.9)}`;
          if (pBAR) pBAR.textContent = currentR.toFixed(1);
          if (pBS) pBS.textContent = `${Math.round(powerS * 0.9)}`;
          if (pBAS) pBAS.textContent = currentS.toFixed(1);
          if (pBT) pBT.textContent = `${Math.round(powerT * 0.9)}`;
          if (pBAT) pBAT.textContent = currentT.toFixed(1);

          const promCurrent = (currentR + currentS + currentT) / 3;
          const maxDiff = Math.max(Math.abs(currentR - promCurrent), Math.abs(currentS - promCurrent), Math.abs(currentT - promCurrent));
          const desbalanceo = promCurrent > 0 ? (maxDiff / promCurrent) * 100 : 0;

          if (pBText) {
            pBText.innerHTML = `<strong>Result:</strong> Phase imbalance calculated at <strong>${desbalanceo.toFixed(1)}%</strong>. ` + 
              (desbalanceo <= 15 ? 'Meets safety standards for load distribution.' : 'Imbalance exceeds recommended levels. Reconfiguration advised.');
          }
        } else {
          printSecBalanceo.style.display = 'none';
        }
      }

      const pConsejosArea = document.getElementById('print-consejos-area-en');
      if (pConsejosArea) {
        pConsejosArea.innerHTML = `
          <ul>
            <li style="margin-bottom: 5px;"><strong>Terminal Blocks:</strong> ${bornerasTexto}</li>
            <li style="margin-bottom: 5px;"><strong>Sub-panels:</strong> ${
              circuitos.length > 8 ? 
              'Consider installing sub-distribution boards for runs exceeding 15m to localize circuits and ease maintenance.' : 
              'Single main panel structure is adequate.'
            }</li>
            <li style="margin-bottom: 5px;"><strong>Incomer Main Cable:</strong> The main supply cable (from utility to panel MCB) must have a copper section of at least <strong>${
              igaIn <= 25 ? '6.0' : (igaIn <= 40 ? '10.0' : '16.0')
            } mm²</strong> to safely support current Ib.</li>
          </ul>
        `;
      }
    }

    function createDINModule(label: string, rating: string, type: string, poles: number, brand: string, circuitType = '') {
      let color = '#777';
      let toggleHtml = '';
      let purposeLabel = '';

      if (type === 'iga') {
        color = '#d32f2f';
        purposeLabel = 'Incomer';
      } else if (type === 'dps') {
        color = '#388e3c';
        purposeLabel = 'Surge Prot.';
      } else if (type === 'rcd') {
        color = '#1976d2';
        purposeLabel = 'RCD / RCCB';
      } else {
        if (circuitType === 'GP-LIGHT') {
          color = '#7b1fa2'; // Purple
          purposeLabel = 'Lights (IUG)';
        } else if (circuitType === 'GP-SOCK') {
          color = '#e65100'; // Orange
          purposeLabel = 'Sockets (TUG)';
        } else if (circuitType === 'SP-LIGHT') {
          color = '#9c27b0'; // Magenta
          purposeLabel = 'Flood. (IUE)';
        } else if (circuitType === 'SP-SOCK') {
          color = '#bf360c'; // Red-orange
          purposeLabel = 'Sockets (TUE)';
        } else if (circuitType === 'MTR-MONO') {
          color = '#00838f'; // Teal
          purposeLabel = 'Motor 1Ф';
        } else if (circuitType === 'MTR-TRI') {
          color = '#006064'; // Deep teal
          purposeLabel = 'Motor 3Ф';
        } else if (circuitType === 'LIFT') {
          color = '#37474f'; // Grey-blue
          purposeLabel = 'Elevator';
        } else if (circuitType === 'AC') {
          color = '#00695c'; // Forest green
          purposeLabel = 'A/C Climate';
        } else {
          color = '#f57c00';
          purposeLabel = 'Circuit';
        }
      }

      for (let p = 0; p < poles; p++) {
        toggleHtml += `
          <div style="width: 8px; height: 22px; background: #222; border-radius: 2px; position: relative; margin: 4px auto 0 auto; display: flex; align-items: center; justify-content: center;">
            <div style="width: 4px; height: 12px; background: #ff5722; border-radius: 1px; transform: translateY(-3px);"></div>
          </div>
        `;
      }

      let testButtonHtml = '';
      if (type === 'rcd') {
        testButtonHtml = `<div style="width: 10px; height: 10px; background: #eee; border: 1px solid #777; border-radius: 2px; color: #333; font-size: 6px; font-weight: 900; line-height: 8px; text-align: center; margin: 2px auto 0 auto; cursor: pointer; user-select: none;">T</div>`;
      }

      const widthVal = poles * 22;

      return `
        <div style="width: ${widthVal}px; background: #fff; border: 1px solid #bbb; border-radius: 4px; padding: 4px 2px; text-align: center; font-family: 'Montserrat', sans-serif; font-size: 7px; color: #111; box-shadow: 0 4px 6px rgba(0,0,0,0.3); flex-shrink: 0; min-height: 95px; display: flex; flex-direction: column; justify-content: space-between;">
          <div style="font-weight: 700; color: ${color}; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 7.5px;">${label}</div>
          <div style="font-size: 6px; color: #888; font-weight: 600;">${brand === 'schneider' ? 'Schneider' : 'Siemens'}</div>
          
          <div style="display: flex; justify-content: center; gap: 2px; margin: 2px 0;">
            ${toggleHtml}
          </div>

          ${testButtonHtml}
          
          <div style="margin-top: auto;">
            <div style="font-size: 8px; font-weight: 800; background: #111; color: #fff; border-radius: 2px; padding: 1px 0; font-family: monospace; margin-bottom: 2px;">${rating}</div>
            <div style="font-size: 5.5px; font-weight: 700; color: ${color}; text-transform: uppercase; border-top: 1px solid rgba(0,0,0,0.06); padding-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${purposeLabel}</div>
          </div>
        </div>
      `;
    }

    const allInputs = [
      iRed, iMarca, iSimultaneidad, iBocasTug, iBocasIug, iBocasTue, 
      iBocasIue, iWIue, iMotoresMono, iHpMono, iMotoresTri, iHpTri, 
      iAscensores, iAcCant, iAcFrigorias
    ];

    allInputs.forEach(input => {
      if (input) {
        if (input.tagName === 'SELECT') {
          input.addEventListener('change', calculateTablero);
        } else {
          input.addEventListener('input', calculateTablero);
        }
      }
    });

    const btnPrint = document.getElementById('tab-btn-print-en');
    if (btnPrint) {
      btnPrint.addEventListener('click', () => {
        const pDate = document.getElementById('print-date-en');
        if (pDate) {
          const today = new Date();
          pDate.textContent = today.toLocaleDateString('en-US') + ' ' + today.toLocaleTimeString('en-US');
        }

        document.body.classList.add('printing-tableros-en');
        window.print();
        window.addEventListener('afterprint', () => document.body.classList.remove('printing-tableros-en'), { once: true });
      });
    }

    handleRedChange();
  });
</script>

<style is:global>
  .tab-btn-en:hover {
    border-color: #FF9100 !important;
    color: #FF9100 !important;
  }
  
  .print-only-tableros-en { display: none; }
  
  @media print {
    body.printing-tableros-en .header, 
    body.printing-tableros-en .footer, 
    body.printing-tableros-en .section-header, 
    body.printing-tableros-en .calculator-grid, 
    body.printing-tableros-en .section { 
      display: none !important; 
    }
    body.printing-tableros-en .print-only-tableros-en {
      display: block !important;
      font-family: Arial, sans-serif;
      color: #000 !important;
      background: #fff !important;
      padding: 10px;
    }
    
    body.printing-tableros-en #print-riel-din-contenedor-en div {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }
</style>
