---
/**
 * CopilotoTecnico.astro - Asistente de Ingeniería N3i con IA
 * Diseñado con protección en 4 capas contra abuso de tokens.
 */
interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;

const isEn = lang === 'en';

const t = {
  btnLabel: isEn ? "N3i AI Copilot" : "Copiloto N3i",
  btnSubtitle: isEn ? "Engineering AI" : "Asistente Técnico",
  headerTitle: isEn ? "N3i Technical Copilot" : "Copiloto Técnico N3i",
  headerSubtitle: isEn ? "Engineering & Maintenance Advisor" : "Asesoría en Ingeniería y Mantenimiento",
  onlineStatus: isEn ? "Online 24/7" : "En línea 24/7",
  welcomeMsg: isEn
    ? "Hello! I am the N3i Technical Assistant. I can help you evaluate electrical installations, HVAC loads, gas systems, or review your electricity bill for reactive power penalties. How can I assist you today?"
    : "¡Hola! Soy el Asistente Técnico de N3i. Puedo orientarte en fallas eléctricas, cálculo de frigorías, normativas AEA/Camuzzi o auditar tu factura de luz para detectar recargos por reactiva. ¿En qué podemos ayudarte?",
  placeholder: isEn ? "Describe your technical inquiry..." : "Describí tu consulta técnica...",
  limitReached: isEn
    ? "You have reached the limit of fast session queries. To receive a detailed evaluation and formal quote, contact Eng. Fabio Gullacci directly via WhatsApp."
    : "Has alcanzado el límite de consultas rápidas por sesión. Para analizar tu caso con un presupuesto formal, contactá directamente al Ing. Fabio Gullacci vía WhatsApp.",
  btnWhatsApp: isEn ? "Chat with Eng. Fabio Gullacci" : "Hablar con el Ing. Fabio Gullacci",
  chips: isEn
    ? [
        { label: "⚡ Power & Panels", query: "How to calculate the main breaker and cable size for a commercial workshop?" },
        { label: "💡 Audit Power Bill", query: "I want to audit my electricity bill to see if I am paying reactive power penalties." },
        { label: "❄️ AC / HVAC Load", query: "How many BTU/cooling capacity do I need for a 35m2 office in Bahía Blanca?" },
        { label: "🏗️ Preventive Plans", query: "What does the PyME Pro Monthly Maintenance Plan include?" }
      ]
    : [
        { label: "⚡ Potencia y Tableros", query: "Cómo calcular la térmica y sección de cables para un taller comercial?" },
        { label: "💡 Auditar Factura de Luz", query: "Quiero auditar mi factura de luz para saber si pago penalidad por energía reactiva." },
        { label: "❄️ Frigorías Climatización", query: "Cuántas frigorías necesito para una oficina de 35 m2 en Bahía Blanca?" },
        { label: "🏗️ Abonos PyME", query: "¿Qué cubre el Abono de Mantenimiento Preventivo PyME Pro?" }
      ]
};
---

<!-- Botón Flotante del Copiloto -->
<button 
  id="copilot-floating-btn" 
  class="copilot-floating-trigger"
  aria-label={t.btnLabel}
  title={t.headerSubtitle}
>
  <div class="copilot-trigger-badge">
    <span class="copilot-badge-sub">{t.btnSubtitle}</span>
    <span class="copilot-badge-main">{t.btnLabel}</span>
  </div>
  <div class="copilot-trigger-icon">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2 2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
      <rect x="4" y="8" width="16" height="12" rx="2"></rect>
      <path d="M2 14h2"></path>
      <path d="M20 14h2"></path>
      <path d="M9 13v2"></path>
      <path d="M15 13v2"></path>
    </svg>
    <div class="copilot-trigger-pulse"></div>
  </div>
</button>

<!-- Backdrop para móviles -->
<div id="copilot-backdrop" class="copilot-backdrop" aria-hidden="true"></div>

<!-- Ventana Modal de Chat del Copiloto -->
<aside id="copilot-chat-panel" class="copilot-panel" aria-hidden="true" role="dialog" aria-labelledby="copilot-title">
  <!-- Barra de agarre para móviles (Bottom Sheet handle) -->
  <div class="copilot-drag-handle" aria-hidden="true"></div>

  <!-- Cabecera -->
  <div class="copilot-header">
    <div class="copilot-header-brand">
      <div class="copilot-avatar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2 2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
          <rect x="4" y="8" width="16" height="12" rx="2"></rect>
          <circle cx="9" cy="13" r="1"></circle>
          <circle cx="15" cy="13" r="1"></circle>
        </svg>
      </div>
      <div>
        <h3 id="copilot-title" class="copilot-header-title">{t.headerTitle}</h3>
        <p class="copilot-header-sub">
          <span class="copilot-status-dot"></span> {t.onlineStatus}
        </p>
      </div>
    </div>
    
    <div class="copilot-header-actions">
      <button id="copilot-clear-btn" class="copilot-icon-btn" title="Reiniciar chat" aria-label="Reiniciar chat">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
      </button>
      <button id="copilot-close-btn" class="copilot-icon-btn" title="Cerrar" aria-label="Cerrar asistente">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
  </div>

  <!-- Contenedor de Mensajes -->
  <div id="copilot-messages" class="copilot-messages">
    <!-- Mensaje Inicial de Bienvenida -->
    <div class="copilot-msg msg-assistant">
      <div class="msg-bubble">
        <p>{t.welcomeMsg}</p>
      </div>
      <span class="msg-time">N3i Copilot</span>
    </div>

    <!-- Chips de Preguntas Frecuentes Rápidas -->
    <div id="copilot-chips" class="copilot-chips">
      {t.chips.map(chip => (
        <button class="copilot-chip" data-query={chip.query}>
          {chip.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Vista previa de imagen seleccionada -->
  <div id="copilot-img-preview" class="copilot-img-preview" style="display: none;">
    <div class="preview-thumbnail-wrap">
      <img id="copilot-preview-thumb" src="" alt="Vista previa" />
      <button id="copilot-remove-img" type="button" class="preview-remove-btn" title="Eliminar imagen">&times;</button>
    </div>
    <span class="preview-text">{isEn ? "Image ready for inspection" : "Imagen lista para inspección"}</span>
  </div>

  <!-- Pie / Input de Consulta -->
  <div class="copilot-footer">
    <div id="copilot-limit-warning" class="copilot-limit-box" style="display: none;">
      <p>{t.limitReached}</p>
      <a 
        id="copilot-whatsapp-lead-btn" 
        href="https://wa.me/5492914168232?text=Hola%20Ing.%20Fabio%20Gullacci,%20estuve%20consultando%20en%20el%20Copiloto%20T%C3%A9cnico%20de%20N3i%20y%20quisiera%20asesoramiento%20personalizado." 
        target="_blank" 
        rel="noopener noreferrer" 
        class="copilot-wa-btn"
      >
        <span>📲</span> {t.btnWhatsApp}
      </a>
    </div>

    <form id="copilot-form" class="copilot-input-form">
      <input 
        type="file" 
        id="copilot-file-input" 
        accept="image/jpeg,image/png,image/webp" 
        style="display: none;" 
      />
      <button 
        type="button" 
        id="copilot-attach-btn" 
        class="copilot-input-icon-btn" 
        title={isEn ? "Attach bill or equipment photo" : "Adjuntar foto de factura o tablero"}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
        </svg>
      </button>

      <input 
        type="text" 
        id="copilot-input" 
        class="copilot-text-input" 
        placeholder={t.placeholder}
        maxlength="400"
        autocomplete="off"
      />

      <button type="submit" id="copilot-send-btn" class="copilot-send-btn" aria-label="Enviar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>

    <div class="copilot-meta">
      <span id="copilot-session-counter">{isEn ? "Queries: 0/6" : "Consultas: 0/6"}</span>
      <span class="copilot-brand-notice">N3i Engineering AI • Bahía Blanca</span>
    </div>
  </div>
</aside>

<script is:inline>
(function() {
  const MAX_QUERIES = 6;
  const STORAGE_KEY = 'n3i_copilot_session_queries_v1';
  const COOLDOWN_MS = 2500;

  let isSending = false;
  let attachedBase64Image = null;

  // Elementos DOM
  const triggerBtn = document.getElementById('copilot-floating-btn');
  const chatPanel  = document.getElementById('copilot-chat-panel');
  const backdrop   = document.getElementById('copilot-backdrop');
  const closeBtn   = document.getElementById('copilot-close-btn');
  const clearBtn   = document.getElementById('copilot-clear-btn');
  const form       = document.getElementById('copilot-form');
  const input      = document.getElementById('copilot-input');
  const messagesEl = document.getElementById('copilot-messages');
  const fileInput  = document.getElementById('copilot-file-input');
  const attachBtn  = document.getElementById('copilot-attach-btn');
  const imgPreview = document.getElementById('copilot-img-preview');
  const thumbImg   = document.getElementById('copilot-preview-thumb');
  const removeImg  = document.getElementById('copilot-remove-img');
  const counterEl  = document.getElementById('copilot-session-counter');
  const limitBox   = document.getElementById('copilot-limit-warning');
  const sendBtn    = document.getElementById('copilot-send-btn');
  const chips      = document.querySelectorAll('.copilot-chip');

  if (!triggerBtn || !chatPanel) return;

  const isEnglish = document.documentElement.lang === 'en';

  // Obtener contador de sesión
  function getQueryCount() {
    return parseInt(sessionStorage.getItem(STORAGE_KEY) || '0', 10);
  }

  function incrementQueryCount() {
    const count = getQueryCount() + 1;
    sessionStorage.setItem(STORAGE_KEY, count.toString());
    updateCounterDisplay();
    return count;
  }

  function updateCounterDisplay() {
    const count = getQueryCount();
    if (counterEl) {
      counterEl.textContent = isEnglish ? `Queries: ${count}/${MAX_QUERIES}` : `Consultas: ${count}/${MAX_QUERIES}`;
    }
    if (count >= MAX_QUERIES) {
      if (form) form.style.display = 'none';
      if (imgPreview) imgPreview.style.display = 'none';
      if (limitBox) limitBox.style.display = 'block';
    } else {
      if (form) form.style.display = 'flex';
      if (limitBox) limitBox.style.display = 'none';
    }
  }

  updateCounterDisplay();

  // Abrir / Cerrar Chat
  triggerBtn.addEventListener('click', () => {
    const isOpen = chatPanel.classList.contains('active');
    if (isOpen) {
      closeChat();
    } else {
      openChat();
    }
  });

  closeBtn?.addEventListener('click', closeChat);
  backdrop?.addEventListener('click', closeChat);

  // Cerrar con tecla Escape (accesibilidad en teclados)
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && chatPanel.classList.contains('active')) {
      closeChat();
    }
  });

  function openChat() {
    chatPanel.classList.add('active');
    backdrop?.classList.add('active');
    chatPanel.setAttribute('aria-hidden', 'false');
    triggerBtn.classList.add('opened');
    if (window.innerWidth <= 768) {
      document.body.style.overflow = 'hidden';
    }
    setTimeout(() => {
      input?.focus();
      scrollToBottom();
    }, 250);
  }

  function closeChat() {
    chatPanel.classList.remove('active');
    backdrop?.classList.remove('active');
    chatPanel.setAttribute('aria-hidden', 'true');
    triggerBtn.classList.remove('opened');
    chatPanel.style.transform = '';
    document.body.style.overflow = '';
  }

  // Gesto táctil swipe-down para cerrar el bottom-sheet en dispositivos móviles
  let touchStartY = 0;
  let touchCurrentY = 0;
  const dragHandle = chatPanel.querySelector('.copilot-drag-handle');
  const headerEl = chatPanel.querySelector('.copilot-header');

  [dragHandle, headerEl].forEach(el => {
    if (!el) return;
    el.addEventListener('touchstart', (e) => {
      touchStartY = e.touches[0].clientY;
      touchCurrentY = touchStartY;
    }, { passive: true });

    el.addEventListener('touchmove', (e) => {
      touchCurrentY = e.touches[0].clientY;
      const diff = touchCurrentY - touchStartY;
      if (diff > 0) {
        chatPanel.style.transform = `translateY(${diff}px)`;
      }
    }, { passive: true });

    el.addEventListener('touchend', () => {
      const diff = touchCurrentY - touchStartY;
      if (diff > 90) {
        closeChat();
      } else {
        chatPanel.style.transform = '';
      }
      touchStartY = 0;
      touchCurrentY = 0;
    });
  });

  // Reiniciar Chat
  clearBtn?.addEventListener('click', () => {
    const initialWelcome = isEnglish
      ? "Hello! I am the N3i Technical Assistant. I can help you evaluate electrical installations, HVAC loads, gas systems, or review your electricity bill for reactive power penalties. How can I assist you today?"
      : "¡Hola! Soy el Asistente Técnico de N3i. Puedo orientarte en fallas eléctricas, cálculo de frigorías, normativas AEA/Camuzzi o auditar tu factura de luz para detectar recargos por reactiva. ¿En qué podemos ayudarte?";
    
    messagesEl.innerHTML = `
      <div class="copilot-msg msg-assistant">
        <div class="msg-bubble">
          <p>${initialWelcome}</p>
        </div>
        <span class="msg-time">N3i Copilot</span>
      </div>
    `;
    clearAttachment();
  });

  // Manejo de Chips Rápidos
  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const q = chip.getAttribute('data-query');
      if (q) {
        input.value = q;
        form.dispatchEvent(new Event('submit'));
      }
    });
  });

  // Adjuntar Imagen con redimensionamiento defensivo a max 800px (Canvas)
  attachBtn?.addEventListener('click', () => fileInput?.click());

  fileInput?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (!file) return;

    if (!file.type.startsWith('image/')) {
      appendMessage('assistant', isEnglish ? '⚠️ Please select a valid image format (JPEG, PNG, WebP).' : '⚠️ Por favor seleccione una imagen en formato válido (JPEG, PNG, WebP).');
      return;
    }

    const reader = new FileReader();
    reader.onload = function(event) {
      const img = new Image();
      img.onload = function() {
        // Redimensionar para no gastar ancho de banda ni tokens
        const maxDim = 800;
        let width = img.width;
        let height = img.height;

        if (width > maxDim || height > maxDim) {
          if (width > height) {
            height = Math.round((height * maxDim) / width);
            width = maxDim;
          } else {
            width = Math.round((width * maxDim) / height);
            height = maxDim;
          }
        }

        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, width, height);

        attachedBase64Image = canvas.toDataURL('image/jpeg', 0.82);
        thumbImg.src = attachedBase64Image;
        imgPreview.style.display = 'flex';
        scrollToBottom();
      };
      img.src = event.target.result;
    };
    reader.readAsDataURL(file);
  });

  removeImg?.addEventListener('click', clearAttachment);

  function clearAttachment() {
    attachedBase64Image = null;
    if (thumbImg) thumbImg.src = '';
    if (imgPreview) imgPreview.style.display = 'none';
    if (fileInput) fileInput.value = '';
  }

  function scrollToBottom() {
    if (messagesEl) {
      messagesEl.scrollTop = messagesEl.scrollHeight;
    }
  }

  // Renderizar Mensaje
  function appendMessage(text, sender = 'user', imageBase64 = null) {
    const msgDiv = document.createElement('div');
    msgDiv.className = `copilot-msg msg-${sender}`;

    let imgHtml = '';
    if (imageBase64) {
      imgHtml = `<img src="${imageBase64}" class="msg-attached-img" alt="Adjunto" />`;
    }

    // Convertir saltos de línea y negritas simples
    const formattedText = text
      .replace(/\n/g, '<br>')
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

    msgDiv.innerHTML = `
      <div class="msg-bubble">
        ${imgHtml}
        <p>${formattedText}</p>
      </div>
      <span class="msg-time">${sender === 'user' ? (isEnglish ? 'You' : 'Tú') : 'N3i Copilot'}</span>
    `;

    messagesEl.appendChild(msgDiv);
    scrollToBottom();
  }

  function showTypingIndicator() {
    const typing = document.createElement('div');
    typing.id = 'copilot-typing';
    typing.className = 'copilot-msg msg-assistant';
    typing.innerHTML = `
      <div class="msg-bubble typing-bubble">
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
      </div>
    `;
    messagesEl.appendChild(typing);
    scrollToBottom();
  }

  function removeTypingIndicator() {
    const typing = document.getElementById('copilot-typing');
    if (typing) typing.remove();
  }

  // Motor Inteligente de Respuesta Técnica Local (Fallback & Heurísticas de N3i)
  function generateSmartResponse(userQuery, hasImage) {
    const q = userQuery.toLowerCase();

    // 1. Detección de Factura / Reactiva
    if (q.includes('factura') || q.includes('edes') || q.includes('reactiva') || q.includes('cos') || q.includes('potencia contratada') || q.includes('boleta') || q.includes('bill')) {
      if (isEnglish) {
        return "An energy audit is key to preventing extra charges on your electricity bill. The critical parameter is the **power factor (cos φ)**: if it drops below 0.95, utility companies like EDES bill heavy penalties for reactive energy.\n\nInstalling an **automatic capacitor bank** through N3i typically pays for itself in under 4 months. Would you like us to schedule an on-site electrical measurement?";
      }
      return "La auditoría de factura es clave para evitar sobrecostos innecesarios. El punto crítico es el **factor de potencia (cos φ)**: si se encuentra por debajo de 0.95, la distribuidora (como EDES) aplica penalidades mensuales por energía reactiva que encarecen la factura un 20% a 40%.\n\nEn **N3i Engineering** diseñamos e instalamos **bancos de capacitores automáticos** que eliminan la multa de inmediato. ¿Deseas coordinar un relevamiento en tu planta o local?";
    }

    // 2. Detección de Cableado, Tableros o Térmicas
    if (q.includes('cable') || q.includes('termica') || q.includes('térmica') || q.includes('tablero') || q.includes('breaker') || q.includes('disyuntor') || q.includes('ampere') || q.includes('caida') || q.includes('caída')) {
      if (isEnglish) {
        return "According to electrical regulations (AEA 90364), sizing depends on three strict criteria: **continuous load capacity**, **maximum allowable voltage drop (<3% for lighting, <5% for motors)**, and short-circuit withstand.\n\nFor industrial machinery or commercial workshops, N3i designs certified power distribution panels and grounding protocols. You can also use our **Cable Sizing Calculator** under our Tools section.";
      }
      return "Según la normativa **AEA 90364**, la elección del conductor no solo depende de la corriente nominal (amperes), sino principalmente de la **caída de tensión admisible** (máximo 3% en iluminación y 5% en fuerza motriz/motores) y la longitud del tendido.\n\nEn **N3i** armamos y certificamos tableros de distribución con protecciones selectivas Schneider/ABB y realizamos mediciones de puesta a tierra con telurímetro bajo protocolo oficial. Podés usar además nuestra calculadora en la sección de Herramientas.";
    }

    // 3. Detección de Climatización / Frigorías
    if (q.includes('frigor') || q.includes('aire') || q.includes('clima') || q.includes('acondicionado') || q.includes('calor') || q.includes('hvac')) {
      if (isEnglish) {
        return "For thermal calculation in Bahía Blanca, standard estimations range from **50 to 65 frigories/m³**, but factors like sheet metal roofing, west-facing glass facades, and personnel heat load significantly alter requirements.\n\nN3i handles installation, ducting, and scheduled preventive maintenance for commercial and industrial VRF/multi-split systems.";
      }
      return "Para el cálculo de climatización en la zona de Bahía Blanca, la base técnica suele rondar entre **50 y 65 frigorías por metro cúbico**, pero intervienen factores térmicos decisivos como techos de chapa sin aislación, ventanales orientados al oeste y la carga de equipos/personas.\n\nEn **N3i** dimensionamos sistemas split, piso-techo y multi-split inverter para locales, bancos e industrias con planes de mantenimiento de filtros y gas.";
    }

    // 4. Abonos Mensuales
    if (q.includes('abono') || q.includes('plan') || q.includes('mantenimiento') || q.includes('costo') || q.includes('pyme') || q.includes('industrial 360')) {
      if (isEnglish) {
        return "N3i offers 3 tailored corporate maintenance tiers:\n• **PyME Start:** Ideal for offices and shops (monthly visits, electrical checkup, prioritized support).\n• **PyME Pro:** For mid-size businesses (bi-weekly checkups, plumbing, AC maintenance, emergency coverage).\n• **Industrial 360:** Comprehensive coverage for warehouses and plants with 24/7 emergency response and priority dispatch.";
      }
      return "N3i cuenta con 3 modalidades de abono mensual adaptadas a cada escala:\n• **PyME Start:** Pensado para locales y oficinas comerciales (visita mensual preventiva, revisión de tableros y luces, guardia prioritaria).\n• **PyME Pro:** Para medianas empresas y depósitos (visitas quincenales, gas, plomería, climatización y descuento en obras).\n• **Industrial 360:** Para plantas logísticas y fabriles con guardia de emergencia 24/7 y mantenimiento integral electromecánico.";
    }

    // 5. Obras y Construcción Steel Frame / Civil
    if (q.includes('steel') || q.includes('frame') || q.includes('durlock') || q.includes('obra') || q.includes('techo') || q.includes('filtrac') || q.includes('reparac')) {
      if (isEnglish) {
        return "N3i executes turnkey commercial and industrial projects, including Steel Frame/Drywall systems (Durlock/Knauf), structural roofing, and sheet metal repairs. We ensure high thermal efficiency and rapid completion times.";
      }
      return "En N3i ejecutamos obras llave en mano civiles e industriales: construcción en Steel Frame y Drywall (Durlock/Knauf), reparación estructural de cubiertas, zinguería a medida y pintura epoxi industrial. Diseñamos cada proyecto con máxima aislación térmica y plazos de obra reducidos.";
    }

    // Respuesta General con invitación a WhatsApp
    if (isEnglish) {
      return `Thank you for your inquiry. Regarding "${userQuery}", N3i Engineering & Maintenance evaluates each case with certified technicians under Argentine AEA/Camuzzi standards.\n\nWould you like to speak directly with Eng. Fabio Gullacci to arrange a site visit or receive a formal estimate?`;
    }
    return `Muchas gracias por tu consulta. En relación a "${userQuery}", en **N3i Engineering & Maintenance** abordamos cada proyecto con profesionales matriculados asegurando cumplimiento normativo y continuidad operativa.\n\n¿Te gustaría que te comuniquemos directamente con el **Ing. Fabio Gullacci** para evaluar tu caso en planta o coordinar una visita técnica?`;
  }

  // Envío del Formulario
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (isSending) return;

    const userText = input.value.trim();
    if (!userText && !attachedBase64Image) return;

    // Verificar límite de consultas
    const currentCount = getQueryCount();
    if (currentCount >= MAX_QUERIES) {
      updateCounterDisplay();
      return;
    }

    isSending = true;
    sendBtn.disabled = true;

    // Incrementar contador
    incrementQueryCount();

    // Guardar referencia de imagen y limpiar formulario
    const imgToSend = attachedBase64Image;
    const textToSend = userText || (isEnglish ? "Please inspect this technical image." : "Por favor inspeccione esta imagen técnica adjunta.");

    input.value = '';
    clearAttachment();

    // Mostrar mensaje del usuario
    appendMessage(textToSend, 'user', imgToSend);

    // Ocultar chips tras la primera interacción
    const chipsContainer = document.getElementById('copilot-chips');
    if (chipsContainer) chipsContainer.style.display = 'none';

    // Mostrar indicador de escritura
    showTypingIndicator();

    try {
      // 1. Intentar llamar al proxy seguro si existe endpoint configurado
      let replyText = '';
      const endpoint = window.N3I_COPILOT_ENDPOINT || '/api/chat';

      let apiSuccess = false;
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: textToSend,
            image: imgToSend ? imgToSend.split(',')[1] : null,
            lang: isEnglish ? 'en' : 'es'
          }),
          signal: AbortSignal.timeout(6000)
        });

        if (response.ok) {
          const data = await response.json();
          if (data && data.reply) {
            replyText = data.reply;
            apiSuccess = true;
          }
        }
      } catch (err) {
        // Fallback silencioso y limpio
        apiSuccess = false;
      }

      // 2. Si no hay backend configurado aún, usar el motor de ingeniería inteligente
      if (!apiSuccess) {
        await new Promise(resolve => setTimeout(resolve, 800)); // Retardo natural de lectura
        replyText = generateSmartResponse(textToSend, !!imgToSend);
      }

      removeTypingIndicator();
      appendMessage(replyText, 'assistant');

      // Botón de WhatsApp tras la respuesta
      const actionDiv = document.createElement('div');
      actionDiv.className = 'copilot-msg-action';
      const encodedWa = encodeURIComponent(
        isEnglish
          ? `Hello Eng. Fabio Gullacci, I was consulting the N3i AI Copilot regarding:\n"${textToSend}"\nI would like to request technical advice.`
          : `Hola Ing. Fabio Gullacci, estuve consultando en el Copiloto Técnico de N3i sobre:\n"${textToSend}"\nQuisiera solicitar asesoramiento técnico personalizado.`
      );
      actionDiv.innerHTML = `
        <a href="https://wa.me/5492914168232?text=${encodedWa}" target="_blank" rel="noopener noreferrer" class="msg-action-btn">
          <span>💬</span> ${isEnglish ? 'Transfer to WhatsApp with Eng. Fabio' : 'Enviar consulta a WhatsApp con el Ing. Fabio'}
        </a>
      `;
      messagesEl.appendChild(actionDiv);
      scrollToBottom();

    } catch (error) {
      removeTypingIndicator();
      appendMessage(
        isEnglish
          ? "We are currently experiencing high volume. You can reach out directly via WhatsApp for instant technical support."
          : "En este momento el servicio está con alta demanda. Podés contactar directamente al Ing. Fabio Gullacci por WhatsApp para una respuesta inmediata.",
        'assistant'
      );
    } finally {
      // Cooldown de 2.5s para evitar spam
      setTimeout(() => {
        isSending = false;
        sendBtn.disabled = false;
        input?.focus();
      }, COOLDOWN_MS);
    }
  });

})();
</script>
