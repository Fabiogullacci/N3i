        },
        subOptions: isEnglish
          ? [
              { label: '🎨 Paint Sizing', query: 'How many liters of latex paint do I need for walls and ceilings?' },
              { label: '🏗️ Turnkey Works by N3i', query: 'What commercial renovation projects has N3i completed?' }
            ]
          : [
