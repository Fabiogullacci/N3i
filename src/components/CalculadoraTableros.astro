<!-- SCRIPTS & LOGIC -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Inputs
    const iRed = document.getElementById('tab-red') as HTMLSelectElement;
    const iMarca = document.getElementById('tab-marca') as HTMLSelectElement;
    const iSimultaneidad = document.getElementById('tab-simultaneidad') as HTMLInputElement;
    const iBocasTug = document.getElementById('tab-bocas-tug') as HTMLInputElement;
    const iBocasIug = document.getElementById('tab-bocas-iug') as HTMLInputElement;
    const iBocasTue = document.getElementById('tab-bocas-tue') as HTMLInputElement;
    const iBocasIue = document.getElementById('tab-bocas-iue') as HTMLInputElement;
    const iWIue = document.getElementById('tab-w-iue') as HTMLInputElement;
    const iMotoresMono = document.getElementById('tab-motores-mono') as HTMLInputElement;
    const iHpMono = document.getElementById('tab-hp-mono') as HTMLSelectElement;
    const iMotoresTri = document.getElementById('tab-motores-tri') as HTMLInputElement;
    const iHpTri = document.getElementById('tab-hp-tri') as HTMLSelectElement;
    const iAscensores = document.getElementById('tab-ascensores') as HTMLInputElement;
    const iAcCant = document.getElementById('tab-ac-cant') as HTMLInputElement;
    const iAcFrigorias = document.getElementById('tab-ac-frigorias') as HTMLSelectElement;

    // Tabs
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');
    const btnTabBalanceo = document.getElementById('btn-tab-balanceo');

    // Tab buttons event
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const tabId = btn.getAttribute('data-tab');
        
        tabBtns.forEach(b => {
          b.classList.remove('active');
          (b as HTMLElement).style.background = 'transparent';
          (b as HTMLElement).style.color = 'var(--text-secondary)';
          (b as HTMLElement).style.borderColor = 'var(--border-color)';
        });
        
        btn.classList.add('active');
        (btn as HTMLElement).style.background = 'rgba(255, 145, 0, 0.1)';
        (btn as HTMLElement).style.color = '#FF9100';
        (btn as HTMLElement).style.borderColor = '#FF9100';

        tabContents.forEach(content => {
          if (content.id === tabId) {
            (content as HTMLElement).style.display = 'block';
          } else {
            (content as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // Toggle trifasico inputs depending on grid selection
    function handleRedChange() {
      const red = iRed.value;
      if (red === 'monofasica') {
        if (iMotoresTri) iMotoresTri.disabled = true;
        if (iHpTri) iHpTri.disabled = true;
        if (iAscensores) iAscensores.disabled = true;
        if (btnTabBalanceo) btnTabBalanceo.style.display = 'none';
        
        // Reset inputs to avoid invalid trifasico items
        if (iMotoresTri) iMotoresTri.value = '0';
        if (iAscensores) iAscensores.value = '0';
      } else {
        if (iMotoresTri) iMotoresTri.disabled = false;
        if (iHpTri) iHpTri.disabled = false;
        if (iAscensores) iAscensores.disabled = false;
        if (btnTabBalanceo) btnTabBalanceo.style.display = 'block';
      }
      calculateTablero();
    }

    iRed.addEventListener('change', handleRedChange);

    // Main calculation
    function calculateTablero() {
      const isTrifasica = iRed.value === 'trifasica';
      const marca = iMarca.value;
      const fs = parseFloat(iSimultaneidad.value) || 0.8;
      
      const bocasTug = parseInt(iBocasTug.value) || 0;
      const bocasIug = parseInt(iBocasIug.value) || 0;
      const bocasTue = parseInt(iBocasTue.value) || 0;
      const bocasIue = parseInt(iBocasIue.value) || 0;
      const wIue = parseFloat(iWIue.value) || 150;
      
      const motoresMono = parseInt(iMotoresMono.value) || 0;
      const hpMono = parseFloat(iHpMono.value) || 1.0;
      const motoresTri = isTrifasica ? (parseInt(iMotoresTri.value) || 0) : 0;
      const hpTri = parseFloat(iHpTri.value) || 2.0;
      const ascensores = isTrifasica ? (parseInt(iAscensores.value) || 0) : 0;
      
      const acCant = parseInt(iAcCant.value) || 0;
      const acFrigorias = parseInt(iAcFrigorias.value) || 9000;

      // Estructura para almacenar circuitos
      let circuitos: any[] = [];
      let nextCircNum = 1;

      // 1. GENERAR CIRCUITOS IUG (Iluminación General)
      if (bocasIug > 0) {
        const nCircIug = Math.ceil(bocasIug / 15);
        const bocasPerCirc = Math.ceil(bocasIug / nCircIug);
        for (let i = 0; i < nCircIug; i++) {
          circuitos.push({
            id: nextCircNum++,
            tipo: 'IUG',
            desc: `Iluminación Uso General (Circuito ${i+1})`,
            bocas: bocasPerCirc,
            potenciaVA: 1500, // Estándar AEA para IUG
            currentIb: 1500 / 220, // 6.8 A
            cableSec: 1.5,
            breakerIn: 10,
            poles: 2,
            curva: 'C',
            fase: 'R' // Se asigna luego
          });
        }
      }

      // 2. GENERAR CIRCUITOS TUG (Tomas General)
      if (bocasTug > 0) {
        const nCircTug = Math.ceil(bocasTug / 15);
        const bocasPerCirc = Math.ceil(bocasTug / nCircTug);
        for (let i = 0; i < nCircTug; i++) {
          circuitos.push({
            id: nextCircNum++,
            tipo: 'TUG',
            desc: `Tomacorrientes Uso General (Circuito ${i+1})`,
            bocas: bocasPerCirc,
            potenciaVA: 2200, // Estándar AEA para TUG
            currentIb: 2200 / 220, // 10 A
            cableSec: 2.5,
            breakerIn: 16,
            poles: 2,
            curva: 'C',
            fase: 'R'
          });
        }
      }

      // 3. GENERAR CIRCUITOS IUE (Iluminación Especial)
      if (bocasIue > 0) {
        const nCircIue = Math.ceil(bocasIue / 12);
        const bocasPerCirc = Math.ceil(bocasIue / nCircIue);
        const totalW = bocasIue * wIue;
        const wPerCirc = totalW / nCircIue;
        for (let i = 0; i < nCircIue; i++) {
          circuitos.push({
            id: nextCircNum++,
            tipo: 'IUE',
            desc: `Iluminación Especial Proyectores (${bocasPerCirc} bocas x ${wIue}W)`,
            bocas: bocasPerCirc,
            potenciaVA: wPerCirc / 0.9, // VA
            currentIb: (wPerCirc / 0.9) / 220,
            cableSec: 2.5,
            breakerIn: 16,
            poles: 2,
            curva: 'C',
            fase: 'R'
          });
        }
      }

      // 4. GENERAR CIRCUITOS TUE (Tomas Especial 20A)
      if (bocasTue > 0) {
        const nCircTue = Math.ceil(bocasTue / 12);
        const bocasPerCirc = Math.ceil(bocasTue / nCircTue);
        for (let i = 0; i < nCircTue; i++) {
          circuitos.push({
            id: nextCircNum++,
            tipo: 'TUE',
            desc: `Tomacorrientes Uso Especial (Tomas 20A) (Circuito ${i+1})`,
            bocas: bocasPerCirc,
            potenciaVA: 3300, // Estándar AEA para TUE
            currentIb: 3300 / 220, // 15 A
            cableSec: 4.0, // Recomendamos 4.0 mm2 para TUE para soportar disipación térmica y térmica de 20A
            breakerIn: 20,
            poles: 2,
            curva: 'C',
            fase: 'R'
          });
        }
      }

      // 5. MOTORES MONOFÁSICOS (Circuitos dedicados APM / Alimentación Carga Única)
      if (motoresMono > 0) {
        const wActiva = hpMono * 746;
        // Ib = W / (V * eta * cosphi)
        const currentNom = wActiva / (220 * 0.8 * 0.8);
        for (let i = 0; i < motoresMono; i++) {
          circuitos.push({
            id: nextCircNum++,
            tipo: 'FM-MONO',
            desc: `Motor Monofásico Bomba/Compresor ${hpMono} HP`,
            bocas: 1,
            potenciaVA: wActiva / 0.8,
            currentIb: currentNom,
            cableSec: 2.5,
            breakerIn: currentNom > 12 ? 20 : 16,
            poles: 2,
            curva: 'D', // Curva de arranque para motores
            fase: 'R'
          });
        }
      }

      // 6. MOTORES TRIFÁSICOS (Red trifásica requerida)
      if (motoresTri > 0 && isTrifasica) {
        const wActiva = hpTri * 746;
        // Ib = W / (sqrt(3) * V_line * eta * cosphi)
        const currentNom = wActiva / (Math.sqrt(3) * 380 * 0.85 * 0.8);
        for (let i = 0; i < motoresTri; i++) {
          circuitos.push({
            id: nextCircNum++,
            tipo: 'FM-TRI',
            desc: `Motor Trifásico Fuerza Motriz ${hpTri} HP`,
            bocas: 1,
            potenciaVA: wActiva / 0.85,
            currentIb: currentNom,
            cableSec: 2.5,
            breakerIn: currentNom > 12 ? 20 : (currentNom > 8 ? 16 : 10),
            poles: 4, // Trifásico + Neutro
            curva: 'D',
            fase: 'RST' // Trifásico
          });
        }
      }

      // 7. ASCENSORES (Trifásico de 7.5 HP)
      if (ascensores > 0 && isTrifasica) {
        const wActiva = 7.5 * 746; // 5595 W
        const currentNom = wActiva / (Math.sqrt(3) * 380 * 0.85 * 0.8); // 12.5 A
        for (let i = 0; i < ascensores; i++) {
          circuitos.push({
            id: nextCircNum++,
            tipo: 'ASCENSOR',
            desc: `Ascensor Trifásico Sala de Máquinas 7.5 HP`,
            bocas: 1,
            potenciaVA: wActiva / 0.85,
            currentIb: currentNom,
            cableSec: 4.0, // Sección recomendada
            breakerIn: 20,
            poles: 4,
            curva: 'D',
            fase: 'RST'
          });
        }
      }

      // 8. AIRES ACONDICIONADOS
      if (acCant > 0) {
        // Frigorías unitarias
        const capTermicaW = acFrigorias * 1.163;
        const potElectricaW = capTermicaW / 3.2; // COP 3.2
        const potElectricaVA = potElectricaW / 0.9; // cosphi 0.9

        // Decidir si es Monofásico o Trifásico
        // Si la red es Trifásica y el AC es grande (>= 9000 frig), se calcula trifásico
        const acIsTrifasico = isTrifasica && acFrigorias >= 9000;

        let currentNom = 0;
        if (acIsTrifasico) {
          currentNom = potElectricaW / (Math.sqrt(3) * 380 * 0.9);
        } else {
          currentNom = potElectricaW / (220 * 0.9);
        }

        for (let i = 0; i < acCant; i++) {
          let cable = 2.5;
          let breaker = 16;
          if (!acIsTrifasico && currentNom > 13) {
            cable = 4.0;
            breaker = 20;
          }

          circuitos.push({
            id: nextCircNum++,
            tipo: 'AC',
            desc: `Equipo AC ${acFrigorias} Frigorías (${acIsTrifasico ? 'Trifásico' : 'Monofásico'})`,
            bocas: 1,
            potenciaVA: potElectricaVA,
            currentIb: currentNom,
            cableSec: cable,
            breakerIn: breaker,
            poles: acIsTrifasico ? 4 : 2,
            curva: 'C',
            fase: acIsTrifasico ? 'RST' : 'R'
          });
        }
      }

      // BALANCEO DE FASES GREEDY (Solo si es trifásica)
      let powerR = 0, currentR = 0;
      let powerS = 0, currentS = 0;
      let powerT = 0, currentT = 0;

      // Primero agregamos trifásicos a todas las fases por igual
      circuitos.forEach(c => {
        if (c.fase === 'RST') {
          // Las cargas trifásicas consumen balanceado en las 3 fases
          // La corriente Ib especificada es la de línea (por fase)
          powerR += c.potenciaVA / 3;
          currentR += c.currentIb;
          powerS += c.potenciaVA / 3;
          currentS += c.currentIb;
          powerT += c.potenciaVA / 3;
          currentT += c.currentIb;
        }
      });

      // Distribuir circuitos monofásicos dinámicamente para lograr el balance
      if (isTrifasica) {
        // Ordenar monofásicos por corriente nominal (mayor a menor)
        const monofasicos = circuitos.filter(c => c.fase !== 'RST');
        monofasicos.sort((a, b) => b.currentIb - a.currentIb);

        monofasicos.forEach(c => {
          // Buscar fase con menor corriente acumulada en este momento
          if (currentR <= currentS && currentR <= currentT) {
            c.fase = 'R';
            powerR += c.potenciaVA;
            currentR += c.currentIb;
          } else if (currentS <= currentR && currentS <= currentT) {
            c.fase = 'S';
            powerS += c.potenciaVA;
            currentS += c.currentIb;
          } else {
            c.fase = 'T';
            powerT += c.potenciaVA;
            currentT += c.currentIb;
          }
        });
      } else {
        // Monofásica: todo a fase R (única)
        circuitos.forEach(c => {
          c.fase = 'R';
          powerR += c.potenciaVA;
          currentR += c.currentIb;
        });
        powerS = currentS = powerT = currentT = 0;
      }

      // CALCULAR DEMANDA MÁXIMA DE POTENCIA SIMULTÁNEA (DMPS)
      let dmpsVA = 0;
      let maxFaseCurrent = 0;
      
      if (isTrifasica) {
        const totalVA = powerR + powerS + powerT;
        dmpsVA = totalVA * fs;
        maxFaseCurrent = Math.max(currentR, currentS, currentT) * fs;
      } else {
        dmpsVA = powerR * fs;
        maxFaseCurrent = currentR * fs;
      }

      // CALCULAR INTERRUPTOR GENERAL AUTOMÁTICO (IGA)
      let igaIn = 16;
      const standardBreakers = [16, 20, 25, 32, 40, 50, 63, 80, 100];
      for (let i = 0; i < standardBreakers.length; i++) {
        if (standardBreakers[i] >= maxFaseCurrent) {
          igaIn = standardBreakers[i];
          break;
        }
        if (i === standardBreakers.length - 1) {
          igaIn = 100; // Máximo estándar
        }
      }

      // RENDERIZAR TABLA DE CIRCUITOS
      const tbody = document.getElementById('tab-planilla-tbody');
      const printTbody = document.getElementById('print-planilla-tbody');
      let tbodyHtml = '';

      circuitos.forEach(c => {
        tbodyHtml += `
          <tr style="border-bottom: 1px solid var(--border-color);">
            <td style="padding: 10px; font-weight: bold;">C${c.id}</td>
            <td style="padding: 10px;">${c.desc}</td>
            <td style="padding: 10px; text-align: center;">${c.bocas} bocas</td>
            <td style="padding: 10px; text-align: center;">${Math.round(c.potenciaVA)} VA</td>
            <td style="padding: 10px; text-align: center;">${c.currentIb.toFixed(1)} A</td>
            <td style="padding: 10px; text-align: center;">${c.cableSec.toFixed(1)} mm²</td>
            <td style="padding: 10px; text-align: center; font-weight: 600;">${c.breakerIn}A (Curva ${c.curva})</td>
            <td style="padding: 10px; text-align: center; font-weight: bold; color: ${c.fase === 'R' ? '#ff4444' : (c.fase === 'S' ? '#ffcc00' : (c.fase === 'T' ? '#33b5e5' : '#8CC63F'))};">${c.fase}</td>
          </tr>
        `;
      });

      if (tbody) tbody.innerHTML = tbodyHtml;
      if (printTbody) printTbody.innerHTML = tbodyHtml;

      // RENDERIZAR RIEL DIN VISUAL
      const rielCont = document.getElementById('riel-din-contenedor');
      const printRielCont = document.getElementById('print-riel-din-contenedor');
      
      let rielHtml = '';

      // 1. AGREGAR IGA (Interruptor General Automático)
      const igaPoles = isTrifasica ? 4 : 2;
      rielHtml += createDINModule(`IGA (${igaPoles}P)`, `${igaIn}A`, 'iga', igaPoles, marca);

      // 2. AGREGAR PROTECTOR DE SOBRETENSIÓN (DPS)
      const dpsRating = isTrifasica ? '3L+N' : 'L+N';
      rielHtml += createDINModule(`DPS Class II`, dpsRating, 'dps', igaPoles, marca);

      // 3. SEPARADORES O DISYUNTORES DE GRUPO (RCD)
      // Agrupamos circuitos de forma lógica para evitar cortes totales:
      let modulosOcupados = igaPoles + igaPoles; // IGA + DPS

      if (!isTrifasica) {
        // Red Monofásica: Agrupamos de a 4 circuitos máximo por disyuntor de 40A
        const totalCircs = circuitos.length;
        const nDisy = Math.ceil(totalCircs / 4);
        
        for (let d = 0; d < nDisy; d++) {
          const rcdIn = igaIn >= 40 ? 40 : 25;
          rielHtml += createDINModule(`ID ${d+1}`, `${rcdIn}A 30mA`, 'rcd', 2, marca);
          modulosOcupados += 2;

          // Circuitos del grupo
          const circsGrupo = circuitos.slice(d*4, (d+1)*4);
          circsGrupo.forEach(c => {
            rielHtml += createDINModule(`C${c.id}`, `${c.breakerIn}A`, 'breaker', 2, marca, c.tipo);
            modulosOcupados += 2;
          });
        }
      } else {
        // Red Trifásica:
        const trifasicos = circuitos.filter(c => c.fase === 'RST');
        const monofasicos = circuitos.filter(c => c.fase !== 'RST');

        if (trifasicos.length > 0) {
          rielHtml += createDINModule(`ID Trif.`, `40A 30mA`, 'rcd', 4, marca);
          modulosOcupados += 4;
          trifasicos.forEach(c => {
            rielHtml += createDINModule(`C${c.id} RST`, `${c.breakerIn}A`, 'breaker', 4, marca, c.tipo);
            modulosOcupados += 4;
          });
        }

        // Cargas monofásicas: Las agrupamos por fases (R, S, T)
        const circsR = monofasicos.filter(c => c.fase === 'R');
        const circsS = monofasicos.filter(c => c.fase === 'S');
        const circsT = monofasicos.filter(c => c.fase === 'T');

        if (circsR.length > 0) {
          rielHtml += createDINModule(`ID Fase R`, `25A 30mA`, 'rcd', 2, marca);
          modulosOcupados += 2;
          circsR.forEach(c => {
            rielHtml += createDINModule(`C${c.id} R`, `${c.breakerIn}A`, 'breaker', 2, marca, c.tipo);
            modulosOcupados += 2;
          });
        }
        if (circsS.length > 0) {
          rielHtml += createDINModule(`ID Fase S`, `25A 30mA`, 'rcd', 2, marca);
          modulosOcupados += 2;
          circsS.forEach(c => {
            rielHtml += createDINModule(`C${c.id} S`, `${c.breakerIn}A`, 'breaker', 2, marca, c.tipo);
            modulosOcupados += 2;
          });
        }
        if (circsT.length > 0) {
          rielHtml += createDINModule(`ID Fase T`, `25A 30mA`, 'rcd', 2, marca);
          modulosOcupados += 2;
          circsT.forEach(c => {
            rielHtml += createDINModule(`C${c.id} T`, `${c.breakerIn}A`, 'breaker', 2, marca, c.tipo);
            modulosOcupados += 2;
          });
        }
      }

      if (rielCont) rielCont.innerHTML = rielHtml;
      if (printRielCont) printRielCont.innerHTML = rielHtml;

      // ACTUALIZAR MÓDULOS Y GABINETE
      const rModulos = document.getElementById('tab-res-modulos');
      const rGabinete = document.getElementById('tab-res-gabinete');
      const rReserva = document.getElementById('tab-res-reserva');
      const rDmps = document.getElementById('tab-res-dmps');
      const rAmperes = document.getElementById('tab-res-amperes');

      if (rModulos) rModulos.textContent = modulosOcupados.toString();

      const gabinetesComerciales = [12, 18, 24, 36, 48, 54, 72];
      let suggestedGab = 72;
      let reservaPerc = 0;
      
      for (let g = 0; g < gabinetesComerciales.length; g++) {
        if (gabinetesComerciales[g] >= modulosOcupados * 1.2) {
          suggestedGab = gabinetesComerciales[g];
          reservaPerc = Math.round(((suggestedGab - modulosOcupados) / suggestedGab) * 100);
          break;
        }
      }

      if (rGabinete) rGabinete.textContent = `${suggestedGab} Módulos`;
      if (rReserva) rReserva.textContent = `Reserve espacio libre: ${reservaPerc}% (${suggestedGab - modulosOcupados} bocas libres).`;

      const activePowerKw = (dmpsVA * 0.9) / 1000;
      if (rDmps) rDmps.textContent = `${activePowerKw.toFixed(1)} kW`;
      if (rAmperes) rAmperes.textContent = `${maxFaseCurrent.toFixed(1)} A máx / fase`;

      // ACTUALIZAR DIAGNÓSTICO DE BALANCEO (Solo trifásico)
      const balWR = document.getElementById('balance-w-r');
      const balAS = document.getElementById('balance-a-r');
      const balWS = document.getElementById('balance-w-s');
      const balASS = document.getElementById('balance-a-s');
      const balWT = document.getElementById('balance-w-t');
      const balAST = document.getElementById('balance-a-t');

      const barR = document.getElementById('balance-bar-r');
      const barS = document.getElementById('balance-bar-s');
      const barT = document.getElementById('balance-bar-t');

      if (isTrifasica) {
        if (balWR) balWR.textContent = `${Math.round(powerR * 0.9)} W`;
        if (balAS) balAS.textContent = `${currentR.toFixed(1)} A`;
        if (balWS) balWS.textContent = `${Math.round(powerS * 0.9)} W`;
        if (balASS) balASS.textContent = `${currentS.toFixed(1)} A`;
        if (balWT) balWT.textContent = `${Math.round(powerT * 0.9)} W`;
        if (balAST) balAST.textContent = `${currentT.toFixed(1)} A`;

        const maxCurrentVal = Math.max(currentR, currentS, currentT, 1);
        if (barR) barR.style.width = `${(currentR / maxCurrentVal) * 100}%`;
        if (barS) barS.style.width = `${(currentS / maxCurrentVal) * 100}%`;
        if (barT) barT.style.width = `${(currentT / maxCurrentVal) * 100}%`;

        const promCurrent = (currentR + currentS + currentT) / 3;
        const maxDiff = Math.max(Math.abs(currentR - promCurrent), Math.abs(currentS - promCurrent), Math.abs(currentT - promCurrent));
        const desbalanceo = promCurrent > 0 ? (maxDiff / promCurrent) * 100 : 0;

        const diagAlert = document.getElementById('balanceo-diagnostic-alert');
        if (diagAlert) {
          if (desbalanceo <= 10) {
            diagAlert.style.borderLeft = '4px solid #8CC63F';
            diagAlert.style.background = 'rgba(140, 198, 99, 0.08)';
            diagAlert.innerHTML = `✅ <strong>Balanceo Óptimo:</strong> El desequilibrio entre fases es del <strong>${desbalanceo.toFixed(1)}%</strong> (Reglamentario < 15%). La distribución de cargas monofásicas es excelente, lo que previene el calentamiento del neutro y optimiza la facturación.`;
          } else if (desbalanceo <= 16) {
            diagAlert.style.borderLeft = '4px solid #ff9800';
            diagAlert.style.background = 'rgba(255, 152, 0, 0.08)';
            diagAlert.innerHTML = `⚠️ <strong>Balanceo Aceptable:</strong> El desequilibrio es del <strong>${desbalanceo.toFixed(1)}%</strong>. Cumple con los límites, pero si añade nuevos consumos intente cargarlos en la fase con menor consumo en el tablero.`;
          } else {
            diagAlert.style.borderLeft = '4px solid #c65353';
            diagAlert.style.background = 'rgba(198, 83, 83, 0.08)';
            diagAlert.innerHTML = `🚨 <strong>Desbalanceo Excesivo:</strong> El desequilibrio entre fases es del <strong>${desbalanceo.toFixed(1)}%</strong>. Esto supera el 16% sugerido y puede generar caídas de tensión en el neutro y disparos intempestivos. Recomendamos reasignar manualmente circuitos monofásicos de tomas especiales (TUE) en otras fases.`;
          }
        }
      }

      // BORNERAS REPARTIDORAS E INFORME DE OPTIMIZACIÓN
      const rBorneras = document.getElementById('tab-res-borneras');
      let bornerasTexto = '';
      let bornerasNombre = 'No requiere';

      if (circuitos.length > 5) {
        if (isTrifasica) {
          bornerasNombre = `Bornera Tetrapolar (4 Polos) de ${igaIn >= 63 ? 125 : 100}A`;
          bornerasTexto = `Dado que posee <strong>${circuitos.length} circuitos</strong> en un suministro trifásico, es **imprescindible** instalar una **Bornera Tetrapolar de Distribución DIN (4 Polos) de ${igaIn >= 63 ? '125A' : '100A'}** con al menos 7 conexiones por barra. Esto permite distribuir de manera ordenada y segura las salidas de la térmica general (IGA) hacia las fases R, S, T y Neutro de los disyuntores secundarios.`;
        } else {
          bornerasNombre = `Bornera Bipolar (2 Polos) de ${igaIn >= 40 ? 100 : 80}A`;
          bornerasTexto = `Para organizar el cableado interno de este tablero monofásico de **${circuitos.length} circuitos**, se aconseja instalar una **Bornera Bipolar DIN (2 Polos) de ${igaIn >= 40 ? '100A' : '80A'}** con 6 a 8 tornillos por barra. Evitará guirnaldas o empalmes "tipo peine" poco seguros en los bornes de las térmicas.`;
        }
      } else {
        bornerasTexto = `Con pocos circuitos (**${circuitos.length}**), puede distribuir el puenteado mediante puentes de conexión tipo peine aislados (barras colectoras) homologados. No es estrictamente necesaria una bornera repartidora, aunque mejora la prolijidad.`;
      }

      if (rBorneras) rBorneras.innerHTML = bornerasTexto;

      // ACTUALIZAR VARIABLES DE IMPRESIÓN
      const pSuministro = document.getElementById('print-suministro');
      const pMarca = document.getElementById('print-marca');
      const pFs = document.getElementById('print-fs');
      const pDmps = document.getElementById('print-dmps');
      const pIga = document.getElementById('print-iga');
      const pBorneras = document.getElementById('print-borneras');
      const pModulos = document.getElementById('print-modulos');
      const pGabinete = document.getElementById('print-gabinete');

      if (pSuministro) pSuministro.textContent = isTrifasica ? 'Trifásico (380V / 220V)' : 'Monofásico (220V)';
      if (pMarca) pMarca.textContent = marca === 'schneider' ? 'Schneider Electric (Acti9 / Easy9)' : 'Siemens (Sentron 5SY / 5SL)';
      if (pFs) pFs.textContent = fs.toString();
      if (pDmps) pDmps.textContent = `${activePowerKw.toFixed(1)} kW (${Math.round(dmpsVA)} VA)`;
      if (pIga) pIga.textContent = `${igaPoles}P x ${igaIn}A (Curva C, Poder de corte: ${marca==='schneider'?'4.5kA / 6kA':'6kA'})`;
      if (pBorneras) pBorneras.textContent = bornerasNombre;
      if (pModulos) pModulos.textContent = `${modulosOcupados} módulos DIN`;
      if (pGabinete) pGabinete.textContent = `${suggestedGab} Módulos DIN (+${reservaPerc}% reserva)`;

      // Balanceo de fases en impresión
      const printSecBalanceo = document.getElementById('print-section-balanceo');
      if (printSecBalanceo) {
        if (isTrifasica) {
          printSecBalanceo.style.display = 'block';
          const pBR = document.getElementById('print-balance-r');
          const pBAR = document.getElementById('print-balance-a-r');
          const pBS = document.getElementById('print-balance-s');
          const pBAS = document.getElementById('print-balance-a-s');
          const pBT = document.getElementById('print-balance-t');
          const pBAT = document.getElementById('print-balance-a-t');
          const pBText = document.getElementById('print-balance-text');

          if (pBR) pBR.textContent = `${Math.round(powerR * 0.9)}`;
          if (pBAR) pBAR.textContent = currentR.toFixed(1);
          if (pBS) pBS.textContent = `${Math.round(powerS * 0.9)}`;
          if (pBAS) pBAS.textContent = currentS.toFixed(1);
          if (pBT) pBT.textContent = `${Math.round(powerT * 0.9)}`;
          if (pBAT) pBAT.textContent = currentT.toFixed(1);

          const promCurrent = (currentR + currentS + currentT) / 3;
          const maxDiff = Math.max(Math.abs(currentR - promCurrent), Math.abs(currentS - promCurrent), Math.abs(currentT - promCurrent));
          const desbalanceo = promCurrent > 0 ? (maxDiff / promCurrent) * 100 : 0;

          if (pBText) {
            pBText.innerHTML = `<strong>Resultado:</strong> Desequilibrio de fases calculado en <strong>${desbalanceo.toFixed(1)}%</strong>. ` + 
              (desbalanceo <= 15 ? 'La instalación cumple las especificaciones de distribución simétrica.' : 'Exceso de corriente reactiva o desequilibrio. Se recomienda reconfigurar la asignación de circuitos en obra.');
          }
        } else {
          printSecBalanceo.style.display = 'none';
        }
      }

      // Consejos en impresión
      const pConsejosArea = document.getElementById('print-consejos-area');
      if (pConsejosArea) {
        pConsejosArea.innerHTML = `
          <ul>
            <li style="margin-bottom: 5px;"><strong>Borneras:</strong> ${bornerasTexto}</li>
            <li style="margin-bottom: 5px;"><strong>Sectores y Subtableros:</strong> ${
              circuitos.length > 8 ? 
              'Se sugiere considerar un Tablero Seccional en caso de distancias superiores a 15m para independizar áreas de trabajo (ej: climatización o iluminación exterior).' : 
              'El tablero único general es adecuado para la magnitud de circuitos calculados.'
            }</li>
            <li style="margin-bottom: 5px;"><strong>Cable unifilar de entrada al tablero:</strong> El cable de alimentación general (de acometida a IGA) debe ser de sección mínima <strong>${
              igaIn <= 25 ? '6.0' : (igaIn <= 40 ? '10.0' : '16.0')
            } mm²</strong> de cobre para soportar la intensidad Ib calculada.</li>
          </ul>
        `;
      }
    }

    // Helper to generate realistic DIN rail modules
    function createDINModule(label: string, rating: string, type: string, poles: number, brand: string, circuitType = '') {
      let color = '#777';
      let toggleHtml = '';
      let purposeLabel = '';

      if (type === 'iga') {
        color = '#d32f2f'; // Red for IGA
        purposeLabel = 'General';
      } else if (type === 'dps') {
        color = '#388e3c'; // Green for surge protection
        purposeLabel = 'Sobretensión';
      } else if (type === 'rcd') {
        color = '#1976d2'; // Blue for disyuntor
        purposeLabel = 'Diferencial';
      } else {
        // Breakers by type of circuit
        if (circuitType === 'IUG') {
          color = '#7b1fa2'; // Purple
          purposeLabel = 'Luces (IUG)';
        } else if (circuitType === 'TUG') {
          color = '#e65100'; // Orange
          purposeLabel = 'Tomas (TUG)';
        } else if (circuitType === 'IUE') {
          color = '#9c27b0'; // Magenta
          purposeLabel = 'Luces (IUE)';
        } else if (circuitType === 'TUE') {
          color = '#bf360c'; // Red-orange
          purposeLabel = 'Tomas (TUE)';
        } else if (circuitType === 'FM-MONO') {
          color = '#00838f'; // Teal
          purposeLabel = 'Motor 1Ф';
        } else if (circuitType === 'FM-TRI') {
          color = '#006064'; // Deep teal
          purposeLabel = 'Motor 3Ф';
        } else if (circuitType === 'ASCENSOR') {
          color = '#37474f'; // Grey-blue
          purposeLabel = 'Ascensor';
        } else if (circuitType === 'AC') {
          color = '#00695c'; // Forest green
          purposeLabel = 'Clima A/C';
        } else {
          color = '#f57c00';
          purposeLabel = 'Circuito';
        }
      }

      for (let p = 0; p < poles; p++) {
        toggleHtml += `
          <div style="width: 8px; height: 22px; background: #222; border-radius: 2px; position: relative; margin: 4px auto 0 auto; display: flex; align-items: center; justify-content: center;">
            <div style="width: 4px; height: 12px; background: #ff5722; border-radius: 1px; transform: translateY(-3px);"></div>
          </div>
        `;
      }

      let testButtonHtml = '';
      if (type === 'rcd') {
        testButtonHtml = `<div style="width: 10px; height: 10px; background: #eee; border: 1px solid #777; border-radius: 2px; color: #333; font-size: 6px; font-weight: 900; line-height: 8px; text-align: center; margin: 2px auto 0 auto; cursor: pointer; user-select: none;">T</div>`;
      }

      const widthVal = poles * 22;

      return `
        <div style="width: ${widthVal}px; background: #fff; border: 1px solid #bbb; border-radius: 4px; padding: 4px 2px; text-align: center; font-family: 'Montserrat', sans-serif; font-size: 7px; color: #111; box-shadow: 0 4px 6px rgba(0,0,0,0.3); flex-shrink: 0; min-height: 95px; display: flex; flex-direction: column; justify-content: space-between;">
          <div style="font-weight: 700; color: ${color}; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 7.5px;">${label}</div>
          <div style="font-size: 6px; color: #888; font-weight: 600;">${brand === 'schneider' ? 'Schneider' : 'Siemens'}</div>
          
          <div style="display: flex; justify-content: center; gap: 2px; margin: 2px 0;">
            ${toggleHtml}
          </div>

          ${testButtonHtml}
          
          <div style="margin-top: auto;">
            <div style="font-size: 8px; font-weight: 800; background: #111; color: #fff; border-radius: 2px; padding: 1px 0; font-family: monospace; margin-bottom: 2px;">${rating}</div>
            <div style="font-size: 5.5px; font-weight: 700; color: ${color}; text-transform: uppercase; border-top: 1px solid rgba(0,0,0,0.06); padding-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${purposeLabel}</div>
          </div>
        </div>
      `;
    }

    // Attach recalculation events
    const allInputs = [
      iRed, iMarca, iSimultaneidad, iBocasTug, iBocasIug, iBocasTue, 
      iBocasIue, iWIue, iMotoresMono, iHpMono, iMotoresTri, iHpTri, 
      iAscensores, iAcCant, iAcFrigorias
    ];

    allInputs.forEach(input => {
      if (input) {
        if (input.tagName === 'SELECT') {
          input.addEventListener('change', calculateTablero);
        } else {
          input.addEventListener('input', calculateTablero);
        }
      }
    });

    // Print event handler
    const btnPrint = document.getElementById('tab-btn-print');
    if (btnPrint) {
      btnPrint.addEventListener('click', () => {
        const pDate = document.getElementById('print-date');
        if (pDate) {
          const today = new Date();
          pDate.textContent = today.toLocaleDateString('es-AR') + ' ' + today.toLocaleTimeString('es-AR');
        }

        // Apply class and launch print
        document.body.classList.add('printing-tableros');
        window.print();
        window.addEventListener('afterprint', () => document.body.classList.remove('printing-tableros'), { once: true });
      });
    }

    // Initialize layout
    handleRedChange();
  });
</script>

<style is:global>
  /* PESTAÑAS Y DISEÑO */
  .tab-btn:hover {
    border-color: #FF9100 !important;
    color: #FF9100 !important;
  }
  
  /* Estilos de Impresión */
  .print-only-tableros { display: none; }
  
  @media print {
    body.printing-tableros .header, 
    body.printing-tableros .footer, 
    body.printing-tableros .section-header, 
    body.printing-tableros .calculator-grid, 
    body.printing-tableros .section { 
      display: none !important; 
    }
    body.printing-tableros .print-only-tableros {
      display: block !important;
      font-family: Arial, sans-serif;
      color: #000 !important;
      background: #fff !important;
      padding: 10px;
    }
    
    body.printing-tableros #print-riel-din-contenedor div {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }
</style>
